<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>URL Shortener Project</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background: #0d0b26;
      background-image: 
        radial-gradient(circle at 50% 50%, rgba(103, 58, 183, 0.3), transparent 60%),
        linear-gradient(135deg, #09071b 0%, #1a153a 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 40px 30px;
      border-radius: 16px;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
      width: 100%;
      max-width: 480px;
      text-align: center;
    }

    h1 {
      color: #ffffff;
      margin-bottom: 24px;
      font-size: 28px;
      font-weight: 700;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 16px;
      text-align: left;
    }

    label {
      font-weight: 500;
      color: #e0e0e0;
      font-size: 15px;
    }

    input[type="text"] {
      width: 100%;
      padding: 14px 16px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 10px;
      font-size: 15px;
      color: #ffffff;
      outline: none;
      transition: all 0.3s ease;
    }

    input[type="text"]::placeholder {
      color: rgba(255, 255, 255, 0.4);
    }

    input[type="text"]:focus {
      border-color: #7b61ff;
      box-shadow: 0 0 12px rgba(123, 97, 255, 0.4);
    }

    button {
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      color: white;
      border: none;
      padding: 14px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
    }

    .result-box {
      margin-top: 25px;
      padding: 18px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      word-break: break-all;
    }

    .result-box p {
      color: #d1d5db;
      font-size: 15px;
      margin-bottom: 6px;
    }

    .result-box a {
      color: #ffffff;
      text-decoration: none;
      font-weight: 700;
      font-size: 16px;
      transition: color 0.2s ease;
    }

    .result-box a:hover {
      color: #a78bfa;
      text-shadow: 0 0 8px rgba(167, 139, 250, 0.6);
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>URL Shortener Project</h1>
    <form action="/short" method="POST">
      <label for="longUrl">Enter Long URL:</label>
      <input type="text" id="longUrl" name="longUrl" placeholder="https://example.com/very-long-url" required>
      <button type="submit">Shorten URL</button>
    </form>

    <% if(shortUrl) { %>
      <div class="result-box">
        <p>Short URL Generated:</p>
        <a href="<%= shortUrl %>" target="_blank"><%= shortUrl %></a>
      </div>
    <% } %>
  </div>
</body>
</html>